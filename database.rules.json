{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      "$code": {

        "hostId":    { ".read": "auth != null", ".write": "auth != null && (!data.exists() || data.val() === auth.uid)" },
        "createdAt": { ".read": "auth != null", ".write": "auth != null" },

        "state": {
          ".read": "auth != null",
          ".write": "auth != null && (!root.child('rooms/'+$code+'/hostId').exists() || root.child('rooms/'+$code+'/hostId').val() === auth.uid)"
        },

        "players": {
          ".read": "auth != null",
          "$pid": {
            ".write": "auth != null && ($pid === auth.uid || root.child('rooms/'+$code+'/hostId').val() === auth.uid)",
            ".validate": "newData.hasChildren(['name','avatar','score'])",
            "name":   { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 14" },
            "avatar": { ".validate": "newData.isString() && newData.val().length <= 8" },
            "score":  { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "online": { ".validate": "newData.isBoolean()" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "answers": {
          "$step": {
            "$pid": {
              "//": "Only the host may read the pile — that's what stops the room peeking at each other mid-question.",
              ".read":  "auth != null && root.child('rooms/'+$code+'/hostId').val() === auth.uid",
              ".write": "auth != null && ($pid === auth.uid || root.child('rooms/'+$code+'/hostId').val() === auth.uid)"
            },
            ".read": "auth != null && root.child('rooms/'+$code+'/hostId').val() === auth.uid"
          },
          ".write": "auth != null && root.child('rooms/'+$code+'/hostId').val() === auth.uid"
        },

        "results": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms/'+$code+'/hostId').val() === auth.uid"
        },

        "$other": { ".validate": false }
      }
    }
  }
}
