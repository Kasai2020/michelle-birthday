{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      "$code": {

        "hostId": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.val() === auth.uid)",
          ".validate": "newData.isString()"
        },

        "createdAt": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".validate": "newData.isNumber()"
        },

        "state": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms/' + $code + '/hostId').val() === auth.uid"
        },

        "players": {
          ".read": "auth != null",
          "$pid": {
            ".write": "auth != null && ($pid === auth.uid || root.child('rooms/' + $code + '/hostId').val() === auth.uid)",
            ".validate": "newData.hasChildren(['name', 'avatar', 'score'])",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 14" },
            "avatar": { ".validate": "newData.isString() && newData.val().length <= 8" },
            "score": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && (root.child('rooms/' + $code + '/hostId').val() === auth.uid || (!data.exists() && newData.val() === 0) || (data.exists() && newData.val() === data.val()))"
            },
            "online": { ".validate": "newData.isBoolean()" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "answers": {
          ".write": "auth != null && root.child('rooms/' + $code + '/hostId').val() === auth.uid",
          "$step": {
            ".read": "auth != null && root.child('rooms/' + $code + '/hostId').val() === auth.uid",
            "$pid": {
              ".write": "auth != null && ($pid === auth.uid || root.child('rooms/' + $code + '/hostId').val() === auth.uid)"
            }
          }
        },

        "locked": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms/' + $code + '/hostId').val() === auth.uid",
          "$step": {
            "$pid": {
              ".write": "auth != null && ($pid === auth.uid || root.child('rooms/' + $code + '/hostId').val() === auth.uid)",
              ".validate": "newData.isBoolean()"
            }
          }
        },

        "results": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms/' + $code + '/hostId').val() === auth.uid"
        },

        "$other": { ".validate": false }
      }
    }
  }
}
